---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import { projects } from "../../data/site";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title={`${project.title} — Jamie Wu`}>
  <Header variant="detail" />

  <main class="project">
    <header class="project-head">
      <h1>{project.title}</h1>
      <p class="year">{project.year}</p>
      <p class="summary">{project.summary}</p>
    </header>

  <section class="gallery" aria-label="Project images">
  {project.images.map((image) => (
    <figure class="plate">
      {image.src ? (
        <img
          src={`${base}/${image.src}`}
          alt={image.captionLine1}
        />
      ) : (
        <PlaceholderImage aspect={image.aspect ?? "landscape"} />
      )}

      <figcaption>
        <span class="caption-line">{image.captionLine1}</span>
        <span class="caption-line">{image.captionLine2}</span>
      </figcaption>
    </figure>
  ))}
  </section>
  </main>
</Layout>

<style>
  .project {
    padding: 4rem 2.5rem 6rem;
  }

  .project-head {
    max-width: 40rem;
    margin: 0 auto 5rem;
    text-align: center;
  }

  .project-head h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .year {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    opacity: var(--muted-opacity);
  }

  .summary {
    margin: 2rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2.5rem;
    align-items: start;
  }

  .plate {
    margin: 0;
  }

  .plate img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Reserve ~two lines of vertical space for every caption
     so the grid rhythm stays consistent. */
  .plate figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    min-height: 2.8em;
    opacity: var(--muted-opacity);
  }

  .caption-line {
    display: block;
  }

  @media (max-width: 900px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .project {
      padding: 2.5rem 1.25rem 4rem;
    }

    .gallery {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
