---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import { artist, projects } from "../data/site";

const featured = projects.slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---


<Layout>
  <Header variant="home" />

  <main class="home">
    <section class="intro">
      <p>{artist.intro}</p>
    </section>

    <section class="featured" aria-label="Featured projects">
      {featured.map((project) => (
        <a
          class="preview"
          href={`${base}/projects/${project.slug}/`}
        >
          {project.cover ? (
            <img
              class="preview-image"
              src={`${base}/${project.cover}`}
              alt={project.title}
            />
          ) : (
            <PlaceholderImage aspect="portrait" />
          )}

          <div class="preview-meta">
            <span class="preview-title">{project.title}</span>
            <span class="preview-year">{project.year}</span>
          </div>
        </a>
      ))}
    </section>
  </main>
</Layout>

<style>
  .home {
    padding: 4rem 2.5rem 6rem;
  }

  .intro {
    max-width: 34rem;
    margin: 0 auto 5rem;
    text-align: center;
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .preview {
    display: block;
  }

  .preview-meta {
    margin-top: 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .preview-title {
    font-size: 1.0625rem;
  }

  .preview-year {
    font-size: 0.875rem;
    opacity: var(--muted-opacity);
  }

  .preview-image {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  @media (max-width: 600px) {
    .home {
      padding: 2.5rem 1.25rem 4rem;
    }

    .intro {
      font-size: 1.125rem;
      margin-bottom: 3.5rem;
    }
  }
</style>
