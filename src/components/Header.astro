---
interface Props {
  variant: "home" | "detail";
}

const { variant } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const homeUrl = `${base}/`;
const bioUrl = `${base}/bio/`;
---

<header class="site-header">
  {variant === "home" && (
    <a class="brand" href={homeUrl}>Jamie Wu</a>
  )}

  <nav class="site-nav" aria-label="Site">
    {variant === "home" ? (
      <a class="nav-link" href={bioUrl}>Bio</a>
    ) : (
      <a
        class="nav-link close"
        href={homeUrl}
        aria-label="Close and return home"
      >
        (x)
      </a>
    )}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 2.25rem 2.5rem 0;
  }

  .brand {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .nav-link {
    font-size: 1.0625rem;
  }

  .nav-link.close {
    font-size: 1.125rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 600px) {
    .site-header {
      padding: 1.75rem 1.25rem 0;
    }
  }
</style>